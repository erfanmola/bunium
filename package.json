{
  "name": "bunium",
  "version": "0.0.1",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src/",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.0.0"
  },
  "optionalDependencies": {
    "bunium-darwin-arm64": "0.0.1"
  },
  "scripts": {
    "build:native:mac": "native/mac/build.sh",
    "pack:mac": "packaging/mac/package.sh",
    "pack:win": "packaging/win/package.sh",
    "release:artifacts": "scripts/stage-release-artifacts.sh",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "docs:dev": "bun run --cwd=docs dev",
    "docs:build": "bun run --cwd=docs build",
    "release:update": "bun scripts/release.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "bun-types": "^1.3.14",
    "typescript": "^7.0.2"
  }
}
