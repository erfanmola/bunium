    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.0.0",
    "bun-types": "^1.3.14",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
